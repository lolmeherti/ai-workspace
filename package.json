{
  "name": "localsy-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/utilities.css -o ./src/css/utilities.css --minify",
    "watch:css": "tailwindcss -i ./assets/utilities.css -o ./src/css/utilities.css --watch",
    "test:ui": "node --test tests/ui/*.test.mjs",
    "check:ui": "node tests/ui/check.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "jsdom": "26.0.0",
    "playwright": "1.51.1",
    "tailwindcss": "3.4.17"
  }
}
