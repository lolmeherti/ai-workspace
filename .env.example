# Localsy — example environment configuration.
#
# Copy to `.env` and adjust. Secrets (DB credentials, API keys) are omitted here
# on purpose; see the live `.env` or the launcher-generated `.env` for those.

# SourceCondenser extraction temperature. Lower = more deterministic durable
# atomic facts (the HOT atomic_context ledger). 0.5 was observed to produce
# run-to-run variance in the extracted atom set; 0.2 is the recommended default.
AGENT_CONDENSER_TEMP=0.2

# Deferred atomization (evidence hygiene). Raw evidence is stored un-atomized;
# a deferred pass atomizes it per-tool-result once a session's accumulated
# un-atomized evidence (or context pressure) justifies the cost.
#
# The backlog threshold and safety headroom are DERIVED from the active context
# size (LLM_CTX_SIZE) via piecewise-linear interpolation — they are NOT fixed
# constants and NOT a single percentage. Anchor points (AtomizationPolicy):
#   backlog threshold:  8k ctx -> 1.5k,  25k -> 8k,  160k -> 30k
#   safety headroom:    8k ctx -> 1k,    25k -> 2.5k, 160k -> 8k
#
#   ATOMIZATION_CONSOLIDATION_MS_SEED  first-use consolidation-cost EMA seed
#                                  (~4.5s, dominated by discarded reasoning).
#   ATOMIZATION_EMA_ALPHA          smoothing factor for the consolidation-cost EMA
#                                  (observability only; not used by the trigger).
ATOMIZATION_CONSOLIDATION_MS_SEED=4500
ATOMIZATION_EMA_ALPHA=0.3
